# Copy to .env and edit. Every variable the platform reads is listed here (AGENTS.md section 13).
# Placeholder values only. Never put a real credential in this file.

# SQLAlchemy URL of the platform's own Postgres (not the legacy application's database).
DATABASE_URL=postgresql://strata:change-me@db:5432/strata  # pragma: allowlist secret

# One of: local, ci, staging, private
ENVIRONMENT=local

LOG_LEVEL=INFO

# Used by docker-compose.yml for the db container only.
POSTGRES_USER=strata
POSTGRES_PASSWORD=change-me
POSTGRES_DB=strata
