# Copy to .env for local runs. Keep in sync with services/api/settings.py.
# Never commit .env. Never put keys here.

# local | staging
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/platform
# Commit baked into the image by the staging pipeline; leave as is locally.
GIT_SHA=unknown
# Where pinned read-only copies of ingested sources are kept.
SNAPSHOT_DIR=.snapshots
# GITHUB_TOKEN is for private repositories only. Set it in your shell, never in a file that is committed.

# Local model server (OpenAI-compatible). Loopback or private address only; hosted APIs are refused.
MODEL_ENDPOINT=http://127.0.0.1:11434/v1
MODEL_NAME=local-model
